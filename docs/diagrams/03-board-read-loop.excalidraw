      "link": null,
      "locked": false,
      "text": "Self-exclusion: each --watch instance writes its surface UUID into ~/.cache/agent-fleet/board-surfaces/<uuid> at start and atexit-removes it. cmux overrides surface titles, so the title-marker fallback alone isn't enough — the registry is the source of truth.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 10,
      "containerId": null,
      "originalText": "Self-exclusion: each --watch instance writes its surface UUID into ~/.cache/agent-fleet/board-surfaces/<uuid> at start and atexit-removes it. cmux overrides surface titles, so the title-marker fallback alone isn't enough — the registry is the source of truth.",
      "lineHeight": 1.25
    }
